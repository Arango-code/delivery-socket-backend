{
  "name": "delivery-socket-backend",
  "version": "1.0.0",
  "description": "Backend Express + Socket.IO para SaaS de delivery de comida",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "build": "npm run db:generate && tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node scripts/seed.cjs",
    "demo": "node scripts/demo.cjs",
    "test": "npm run build && node --test dist/tests/core.test.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.4.0",
    "@prisma/client": "7.4.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.3",
    "pg": "^8.16.3",
    "socket.io": "4.8.4",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.2",
    "nodemon": "^3.1.10",
    "prisma": "7.4.0",
    "socket.io-client": "4.8.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "engine.io": "6.6.11",
    "proxy-addr": "2.0.8",
    "socket.io-adapter": "2.5.8",
    "socket.io-parser": "4.2.7"
  }
}
